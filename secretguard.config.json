{
  "version": "1.0.0",
  "rules": {
    "enabled": true,
    "disabledRuleIds": [],
    "customRules": []
  },
  "scan": {
    "excludePatterns": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/*.min.js",
      "**/vendor/**"
    ],
    "maxFileSizeKb": 500,
    "entropyThreshold": 3.5
  },
  "hooks": {
    "installPreCommit": true
  },
  "realtime": {
    "enabled": true,
    "debounceMs": 800
  }
}
